# --- Gemini (resume screening) ---
GEMINI_API_KEY=
# Optional: override the model used for screening
GEMINI_MODEL=gemini-3.8-flash

# --- Resend (candidate emails) ---
RESEND_API_KEY=
# Must be an address on a domain you've verified in Resend.
# onboarding@resend.dev works for testing but only delivers to your own Resend account email.
RESEND_FROM_EMAIL="Kargo Hiring <onboarding@resend.dev>"
# Optional: where candidate replies should go
RESEND_REPLY_TO=

# --- Branding used in email templates (exposed to the browser) ---
NEXT_PUBLIC_COMPANY_NAME=Kargo
NEXT_PUBLIC_SENDER_NAME=The Kargo Team
# Optional: a Calendly/Cal.com link inserted into interview invites
NEXT_PUBLIC_SCHEDULING_URL=
